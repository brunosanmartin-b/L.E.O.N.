# Plantilla de variables de entorno para el proyecto
# Copia este archivo como .env y coloca tus claves reales

GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash
WAKE_WORD=leon

# Voz neuronal (Edge TTS, gratuita). Ejemplos:
#   es-ES-AlvaroNeural, es-MX-JorgeNeural, es-CO-GonzaloNeural, es-AR-TomasNeural
#   Femeninas: es-ES-ElviraNeural, es-MX-DaliaNeural
LEON_VOICE=es-ES-AlvaroNeural
LEON_VOICE_RATE=+4%
LEON_VOICE_PITCH=-2Hz

# Interfaz web (http://127.0.0.1:8765)
LEON_UI_PORT=8765
LEON_OPEN_UI=1
